        android:shortcutShortLabel="@string/shortcut_rewind">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="com.brito.tunebox"
            android:targetClass="com.brito.tunebox.MainActivity"
            android:data="tunebox://app/taste/rewind" />
    </shortcut>
    <shortcut android:shortcutId="sleep" android:enabled="true"
        android:icon="@drawable/ic_sc_sleep"
        android:shortcutShortLabel="@string/shortcut_sleep">
        <intent android:action="android.intent.action.VIEW"
